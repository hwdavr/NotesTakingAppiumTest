# Paths resolve from this project, independently of the current directory.
# ANDROID_HOME=/absolute/path/to/Android/sdk
# JAVA_HOME=/absolute/path/to/jdk-17
# ANDROID_UDID=emulator-5554
# APP_PATH=../NotesTakingApp/app/build/outputs/apk/debug/app-debug.apk
APP_PACKAGE=com.example.notesapp
APP_ACTIVITY=com.example.notesapp.MainActivity
APPIUM_PORT=4723
# Set only to use an already running server (local or HTTPS remote).
# APPIUM_SERVER_URL=http://127.0.0.1:4723/
WAIT_TIMEOUT_MS=15000
CONNECTION_TIMEOUT_MS=120000
CAPTURE_PAGE_SOURCE=false
# Tests require a dedicated device isolated from production networking.
# Offline is checked by default. Set true ONLY for a verified isolated test network.
TEST_NETWORK_ISOLATED=false
# Optional title prefix for create-4x4-table.spec.ts; a unique ownership suffix is appended.
# QA_NOTE_TITLE=QA 4x4 table
