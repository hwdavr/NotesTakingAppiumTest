{
  "name": "notes-appium-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Appium Android UI automation for NotesTakingApp",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup:driver": "tsx scripts/setup-driver.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "tsx scripts/run.ts smoke",
    "test:smoke": "tsx scripts/run.ts smoke",
    "test:authenticated": "tsx scripts/run.ts authenticated",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "report:generate": "tsx scripts/report.ts",
    "report:open": "tsx scripts/report.ts --open"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@wdio/allure-reporter": "10.1.0",
    "@wdio/appium-service": "10.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/junit-reporter": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "allure-commandline": "2.46.1",
    "appium": "3.9.0",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "expect-webdriverio": "8.0.0",
    "globals": "17.13.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "webdriverio": "10.1.0"
  }
}
