{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "@wdio/appium-service"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "config/**/*.ts",
    "scripts/**/*.ts",
    "screens/**/*.ts",
    "support/**/*.ts",
    "tests/**/*.ts",
    "wdio.conf.ts"
  ]
}
